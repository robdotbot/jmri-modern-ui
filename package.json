{
  "name": "jmri-modern-ui",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy": "npm run build && node scripts/deploy.mjs",
    "typecheck": "tsc -b",
    "test:e2e": "node tests/e2e.mjs && node tests/e2e-features.mjs",
    "build:addon": "node addon/build.mjs",
    "test:e2e:noaddon": "node tests/e2e-noaddon.mjs",
    "test:e2e:panels": "node tests/e2e-panel-edit.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "playwright": "^1.64.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  },
  "description": "A modern web UI for JMRI, built on its JSON/WebSocket server"
}
